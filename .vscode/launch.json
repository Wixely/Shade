{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shade (Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Shade/bin/Debug/net10.0/Shade.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Shade (software renderer)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Shade/bin/Debug/net10.0/Shade.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": { "CUPRIFACE_SOFTWARE": "1" }
    },
    {
      "name": "Shade checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/Shade.Tests/bin/Debug/net10.0/Shade.Tests.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
